#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"

qmake6 "$ROOT/omastream.pro"
make -j"$(nproc)"
gcc -O2 -shared -fPIC -o "$ROOT/build/libomastream_privacy.so" "$ROOT/src/plugin_privacy.c" -I/usr/include/gsr -lGLESv2 -ldl

echo "Built $ROOT/build/omastream and $ROOT/build/libomastream_privacy.so"
