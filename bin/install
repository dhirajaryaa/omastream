#!/bin/sh
# Installs at the user level: the binary in ~/.local/bin, the desktop entry
# and the icon where the launcher looks. `bin/install --package` tries the
# Arch package route instead (needs the sudo password).
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

case "${1:-}" in
  --package)
    "$ROOT/bin/build"
    cd "$ROOT/pkgbuild"
    exec makepkg -fsi ;;
  "") ;;
  *) echo "usage: bin/install [--package]"; exit 1 ;;
esac

"$ROOT/bin/build"
mkdir -p "$HOME/.local/bin" "$HOME/.local/lib/omastream"
install -m 755 "$ROOT/build/omastream" "$HOME/.local/bin/omastream"
install -m 755 "$ROOT/cli/omastream" "$HOME/.local/bin/omastream-cli"
install -m 755 "$ROOT/build/libomastream_privacy.so" "$HOME/.local/lib/omastream/libomastream_privacy.so"
mkdir -p "$HOME/.local/share/applications"
install -m 644 "$ROOT/pkgbuild/omastream.desktop" "$HOME/.local/share/applications/omastream.desktop"
mkdir -p "$HOME/.local/share/icons/hicolor/scalable/apps"
install -m 644 "$ROOT/pkgbuild/omastream.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/omastream.svg"
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -qf "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
echo "Omastream installed — open it from your app launcher (Super + Space)."
