pkgname=omastream
pkgver=1.2.2
pkgrel=1
pkgdesc='Multi-platform live streaming studio for Omarchy & Arch Linux (YouTube, Twitch, Kick) — native GPU privacy filter plugin, in-app confidence preview, camera bubble, one honest window'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libpulse' 'gpu-screen-recorder' 'jq')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omastream "$pkgdir/usr/bin/omastream"
  install -Dm755 cli/omastream "$pkgdir/usr/bin/omastream-cli"
  install -Dm755 build/libomastream_privacy.so "$pkgdir/usr/lib/omastream/libomastream_privacy.so"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omastream.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omastream.svg"
  install -Dm644 "$startdir/omastream.desktop" "$pkgdir/usr/share/applications/omastream.desktop"
  for s in 512x512 256x256 128x128 64x64; do
    install -Dm644 "assets/icons/$s/apps/omastream.png" "$pkgdir/usr/share/icons/hicolor/$s/apps/omastream.png"
  done
  for f in manifest.json Service.qml CameraBubble.qml PrivacyOverlay.qml BarWidget.qml; do
    install -Dm644 "plugin/$f" "$pkgdir/usr/share/omastream/plugin/$f"
  done
}
